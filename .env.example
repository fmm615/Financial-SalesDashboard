# Browser-safe Supabase values. These are placeholders only.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the current publishable key. ANON remains a compatibility fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot server-only integration values. Obtain these from HubSpot; never expose
# them to the browser or commit the values. See docs/HUBSPOT_SETUP.md.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_WEBHOOK_CLIENT_SECRET=
# Set to the exact public URL registered in HubSpot when deployed.
HUBSPOT_WEBHOOK_CALLBACK_URL=
HUBSPOT_DEAL_NAME_PROPERTY=dealname
HUBSPOT_AMOUNT_PROPERTY=amount
HUBSPOT_CURRENCY_PROPERTY=hs_currency
HUBSPOT_STAGE_PROPERTY=dealstage
HUBSPOT_CLOSE_DATE_PROPERTY=closedate
HUBSPOT_RENEWAL_DATE_PROPERTY=
HUBSPOT_OWNER_ID_PROPERTY=hubspot_owner_id
HUBSPOT_LAST_MODIFIED_PROPERTY=hs_lastmodifieddate
HUBSPOT_EXCHANGE_RATE_TO_USD_PROPERTY=
# Required: map actual HubSpot stage IDs to existing PLAYBOOK stage codes.
HUBSPOT_STAGE_MAP_JSON={}

# Used only by the server-to-server daily reconciliation endpoint.
INTEGRATION_CRON_SECRET=
